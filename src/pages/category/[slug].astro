---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PageBanner from "../../components/PageBanner.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${term.label} News`} description={`Construction articles filed under ${term.label}`}>
	<PageBanner
		highlight="Category:"
		title={term.label}
		subtitle={term.description || `Articles filed under ${term.label}, newest first.`}
		backgroundImage="/images/structure/banner-blog.jpg"
		breadcrumbs={[
			{ label: "News", href: "/posts" },
			{ label: term.label },
		]}
	/>

	<section class="band section">
		<div class="frame">
			{
				filteredPosts.length > 0 ? (
					<>
						<div class="post-grid">
							{filteredPosts.map(({ post, tags }) => (
								<PostCard
									post={post}
									tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
								/>
							))}
						</div>
						<Pagination
							basePath={`/category/${term.slug}`}
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "No more posts" : "Nothing here yet"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "This page is past the last post."
								: `No posts have been filed under ${term.label} so far.`}
						</p>
						<div class="empty-state__actions">
							<a
								href={cursor ? `/category/${term.slug}` : "/posts"}
								class="btn btn--ghost"
							>
								{cursor ? "Back to the first page" : "Browse all posts"}
							</a>
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>
