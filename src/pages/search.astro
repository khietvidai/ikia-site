---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";
import PageBanner from "../components/PageBanner.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

const { items: results, nextCursor } = query
	? await search(query, {
			collections: ["projects", "services", "posts", "pages"],
			limit: 30,
		})
	: { items: [], nextCursor: undefined };

function escapeHtml(text: string) {
	return text
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
}

function resolveResultPath(collection: string | undefined, slugOrId: string) {
	switch (collection) {
		case "projects":
			return `/projects/${slugOrId}`;
		case "services":
			return `/services/${slugOrId}`;
		case "pages":
			return `/pages/${slugOrId}`;
		default:
			return `/posts/${slugOrId}`;
	}
}

const rows = results.map((result) => {
	const title = result.title ?? "Untitled";
	const snippetIsTitle =
		result.snippet?.replaceAll("<mark>", "").replaceAll("</mark>", "") ===
		escapeHtml(title);
	const slugOrId = result.slug ?? result.id;
	return {
		collection: result.collection ?? "posts",
		path: resolveResultPath(result.collection, slugOrId),
		title,
		titleHtml: snippetIsTitle ? result.snippet : undefined,
		snippet: snippetIsTitle ? undefined : result.snippet,
	};
});

const countLabel = nextCursor
	? `Top ${rows.length} results`
	: `${rows.length} ${rows.length === 1 ? "result" : "results"}`;
---

<Base
	title={query ? `Search: ${query}` : "Search Site"}
	description="Search projects, construction services, articles, and company pages"
>
	<PageBanner
		highlight="Site"
		title="Search"
		subtitle="Search across completed projects, construction services, engineering articles, and company documentation."
		backgroundImage="/images/structure/banner-projects.jpg"
		breadcrumbs={[{ label: "Search" }]}
	/>

	<section class="band section">
		<div class="frame">
			<form
				method="get"
				action="/search"
				role="search"
				aria-label="Site content"
				class="search-form"
			>
				<label for="search-query" class="sr-only">
					Search projects, services, and articles
				</label>
				<div class="search-field">
					<input
						id="search-query"
						class="search-field__input"
						type="search"
						name="q"
						value={query}
						placeholder="Search projects, services, BIM, renovation..."
						autofocus={!query}
					/>
					<button type="submit" class="st-btn search-field__submit">
						Search
					</button>
				</div>
			</form>

			{
				query ? (
					rows.length > 0 ? (
						<div class="search-results-wrap">
							<p class="search-summary">
								<strong>{countLabel}</strong> matching “{query}”
							</p>
							<ol class="results" role="list">
								{rows.map((row) => (
									<li class="result">
										<span class="result__badge">{row.collection}</span>
										<h2 class="result__title">
											<a href={row.path} class="result__link">
												{row.titleHtml ? (
													<Fragment set:html={row.titleHtml} />
												) : (
													row.title
												)}
											</a>
										</h2>
										{row.snippet && (
											<p class="result__snippet" set:html={row.snippet} />
										)}
										<p class="result__path">{row.path}</p>
									</li>
								))}
							</ol>
						</div>
					) : (
						<div class="empty-state">
							<h2 class="empty-state__title">No matches for “{query}”</h2>
							<p class="empty-state__text">
								Try searching for “renovation”, “design”, “villa”, or browse our
								core sections below.
							</p>
							<div class="empty-state__actions">
								<a href="/projects" class="st-btn">View Projects</a>
								<a href="/services" class="st-btn st-btn--ghost">Our Services</a>
							</div>
						</div>
					)
				) : (
					<div class="search-quicklinks">
						<a href="/projects" class="st-btn st-btn--ghost st-btn--sm">Browse Projects</a>
						<a href="/services" class="st-btn st-btn--ghost st-btn--sm">Our Services</a>
						<a href="/cost-calculator" class="st-btn st-btn--ghost st-btn--sm">Cost Calculator</a>
						<a href="/posts" class="st-btn st-btn--ghost st-btn--sm">Latest News</a>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.search-form {
		max-inline-size: 680px;
	}

	.search-field {
		display: flex;
		gap: 0.6rem;
	}

	.search-field__input {
		flex: 1;
		min-block-size: 48px;
		padding-inline: 1rem;
		border: 2px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.search-field__input:focus {
		outline: 2px solid transparent;
		border-color: var(--st-yellow);
	}

	.search-quicklinks {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-block-start: var(--spacing-6);
	}

	.search-results-wrap {
		margin-block-start: var(--spacing-8);
	}

	.search-summary {
		margin-block-end: var(--spacing-5);
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	.results {
		display: grid;
		gap: 1rem;
		list-style: none;
	}

	.result {
		position: relative;
		padding: 1.35rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-inline-start: 4px solid var(--st-yellow);
		border-radius: var(--radius);
	}

	.result__badge {
		display: inline-block;
		margin-block-end: 0.35rem;
		padding: 2px 7px;
		background: var(--color-fill);
		font-family: var(--font-heading);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.result__title {
		font-size: 1.15rem;
		text-transform: uppercase;
	}

	.result__link {
		color: var(--color-text);
		text-decoration: none;
	}

	.result__link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.result__snippet {
		margin-block-start: 0.4rem;
		font-size: 0.92rem;
		color: var(--color-text-secondary);
	}

	.result__path {
		margin-block-start: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.results :global(mark) {
		padding-inline: 2px;
		background: var(--st-yellow-soft);
		color: var(--color-text);
		font-weight: 700;
	}

	@media (max-width: 560px) {
		.search-field {
			flex-direction: column;
		}
	}
</style>
