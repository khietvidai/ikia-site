---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CostCalculator from "../components/CostCalculator.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [
	servicesRes,
	projectsRes,
	projectTermsRes,
	testimonialsRes,
	postsRes,
	settingsRes,
] = await Promise.all([
	getEmDashCollection("services", { limit: 6 }),
	getEmDashCollection("projects", { limit: 8 }),
	getTaxonomyTermsWithCacheHint("project_category", { includeCounts: false }),
	getEmDashCollection("testimonials", { limit: 4 }),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 3,
	}),
	getSiteSettingsWithCacheHint(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(servicesRes.cacheHint);
	Astro.cache.set(projectsRes.cacheHint);
	Astro.cache.set(projectTermsRes.cacheHint);
	Astro.cache.set(testimonialsRes.cacheHint);
	Astro.cache.set(postsRes.cacheHint);
	Astro.cache.set(settingsRes.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsRes.data);

const services = servicesRes.entries;
const projects = projectsRes.entries;
const projectCategories = projectTermsRes.data;
const testimonials = testimonialsRes.entries;
const posts = postsRes.entries;

const [projectCatsByEntry, postTagsByEntry] = await Promise.all([
	getTermsForEntries(
		"projects",
		projects.map((p) => p.data.id),
		"project_category",
	),
	getTermsForEntries(
		"posts",
		posts.map((p) => p.data.id),
		"tag",
	),
]);

const projectsWithCats = projects.map((project) => ({
	project,
	categories: (projectCatsByEntry.get(project.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

const postsWithTags = posts.map((post) => ({
	post,
	tags: (postTagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

const heroSlides = [
	{
		image: "/images/structure/hero-1.webp",
		srcset:
			"/images/structure/hero-1-640.webp 640w, /images/structure/hero-1-768.webp 768w, /images/structure/hero-1-1080.webp 1080w, /images/structure/hero-1.webp 1920w",
		alt: "Structural steel and crane operations on a modern commercial build",
		kicker: "Welcome to Structure Construction",
		headline: "Building Great Things",
		lead: "Turnkey Design-Build, Commercial Contracting & Civil Engineering backed by ISO 9001 quality governance and a 10-year structural warranty.",
		primaryCta: { label: "Explore Projects", href: "/projects" },
		secondaryCta: { label: "Get a Free Quote", href: "/contact#quote-form" },
	},
	{
		image: "/images/structure/hero-2.webp",
		srcset:
			"/images/structure/hero-2-640.webp 640w, /images/structure/hero-2-768.webp 768w, /images/structure/hero-2-1080.webp 1080w, /images/structure/hero-2.webp 1920w",
		alt: "Field engineers inspecting architectural concrete and site blueprints",
		kicker: "5D BIM & Pre-Construction Certainty",
		headline: "On Time & On GMP Budget",
		lead: "Eliminate change-order surprises with clash-free BIM modeling, open-book Guaranteed Maximum Price schedules, and self-performing structural crews.",
		primaryCta: { label: "Cost Calculator", href: "/cost-calculator" },
		secondaryCta: { label: "Our Services", href: "/services" },
	},
	{
		image: "/images/structure/hero-3.webp",
		srcset:
			"/images/structure/hero-3-640.webp 640w, /images/structure/hero-3-768.webp 768w, /images/structure/hero-3-1080.webp 1080w, /images/structure/hero-3.webp 1920w",
		alt: "Contemporary architectural facade and sustainable building envelope",
		kicker: "Renovation & Net-Zero Retrofits",
		headline: "Engineered To Endure",
		lead: "From heritage masonry stabilization to LEED Platinum commercial upgrades, our superintendents protect every millimeter of craftsmanship.",
		primaryCta: { label: "About Structure", href: "/pages/about" },
		secondaryCta: { label: "Speak With an Engineer", href: "/contact" },
	},
];

const stats = [
	{ number: "2,368", label: "Projects Completed" },
	{ number: "999+", label: "Engineers & Skilled Crew" },
	{ number: "124", label: "Safety & Build Awards" },
	{ number: "18+", label: "Years Field Excellence" },
];

const partnerLogos = [
	{ src: "/images/structure/client-01.png", alt: "Partner 01" },
	{ src: "/images/structure/client-02.png", alt: "Partner 02" },
	{ src: "/images/structure/client-03.png", alt: "Partner 03" },
	{ src: "/images/structure/client-04.png", alt: "Partner 04" },
	{ src: "/images/structure/client-05.png", alt: "Partner 05" },
	{ src: "/images/structure/client-06.png", alt: "Partner 06" },
];
---

<Base title={siteTitle} description={siteTagline}>
	<Fragment slot="head">
		<link
			rel="preload"
			as="image"
			href="/images/structure/hero-1.webp"
			imagesrcset="/images/structure/hero-1-640.webp 640w, /images/structure/hero-1-768.webp 768w, /images/structure/hero-1-1080.webp 1080w, /images/structure/hero-1.webp 1920w"
			imagesizes="100vw"
			fetchpriority="high"
		/>
	</Fragment>

	<!-- 1. Hero Multi-Slide Banner -->
	<section class="st-hero" aria-roledescription="carousel" aria-label="Featured highlights" data-hero-carousel>
		<div class="st-hero__slides">
			{
				heroSlides.map((slide, idx) => (
					<div
						class:list={["st-hero__slide", { "is-active": idx === 0 }]}
						role="group"
						aria-roledescription="slide"
						aria-label={`${idx + 1} of ${heroSlides.length}`}
						aria-hidden={idx === 0 ? "false" : "true"}
						data-hero-slide={idx}
					>
						{idx === 0 ? (
							<img
								src={slide.image}
								srcset={slide.srcset}
								sizes="100vw"
								alt={slide.alt}
								width="1920"
								height="680"
								class="st-hero__bg"
								fetchpriority="high"
								decoding="async"
							/>
						) : (
							<img
								data-src={slide.image}
								data-srcset={slide.srcset}
								sizes="100vw"
								alt={slide.alt}
								width="1920"
								height="680"
								class="st-hero__bg"
								fetchpriority="low"
								decoding="async"
							/>
						)}
						<div class="st-hero__overlay" aria-hidden="true" />
						<div class="frame st-hero__content">
							<p class="st-hero__kicker">{slide.kicker}</p>
							{idx === 0 ? (
								<h1 class="st-hero__title">
									<span class="st-brackets">{slide.headline}</span>
								</h1>
							) : (
								<h2 class="st-hero__title">
									<span class="st-brackets">{slide.headline}</span>
								</h2>
							)}
							<p class="st-hero__lead">{slide.lead}</p>
							<div class="st-hero__actions">
								<a href={slide.primaryCta.href} class="st-btn">
									{slide.primaryCta.label}
								</a>
								<a href={slide.secondaryCta.href} class="st-btn st-btn--outline-light">
									{slide.secondaryCta.label}
								</a>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="frame st-hero__controls">
			<div class="st-hero__dots" role="group" aria-label="Choose slide">
				{
					heroSlides.map((slide, idx) => (
						<button
							type="button"
							class:list={["st-hero__dot", { "is-active": idx === 0 }]}
							aria-current={idx === 0 ? "true" : undefined}
							aria-label={`Slide ${idx + 1}: ${slide.headline}`}
							data-hero-dot={idx}
						/>
					))
				}
			</div>
			<div class="st-hero__arrows">
				<button type="button" class="st-hero__arrow" aria-label="Previous slide" data-hero-prev>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
						<path d="m15 18-6-6 6-6"></path>
					</svg>
				</button>
				<button type="button" class="st-hero__arrow" aria-label="Next slide" data-hero-next>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</button>
			</div>
		</div>
	</section>

	<!-- 2. Iconic Structure Yellow CTA Ribbon -->
	<section class="st-quote-ribbon" aria-label="Quick quote callout">
		<div class="frame st-quote-ribbon__inner">
			<div>
				<h2 class="st-quote-ribbon__title">
					Looking for a high-quality constructor for your next project?
				</h2>
				<p class="st-quote-ribbon__sub">
					Receive an itemized CSI MasterFormat pre-construction estimate within
					5 business days.
				</p>
			</div>
			<div class="st-quote-ribbon__actions">
				<a href="/contact#quote-form" class="st-btn st-btn--navy">
					Get a Quote
				</a>
				<a href="#home-estimator" class="st-btn st-btn--ghost">
					30s Cost Estimator
				</a>
			</div>
		</div>
	</section>

	<!-- 3. Our Core Services -->
	<section class="band section" aria-labelledby="home-services-heading">
		<div class="frame">
			<div class="st-section-header">
				<div>
					<p class="st-kicker">What We Do Best</p>
					<h2 id="home-services-heading" class="st-heading">Our Services</h2>
				</div>
				<a href="/services" class="arrow-link">
					All Construction Services
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>

			{
				services.length > 0 ? (
					<div class="st-grid-3">
						{services.map((service) => (
							<ServiceCard service={service} headingLevel={3} />
						))}
					</div>
				) : (
					<div class="empty-state">
						<h3 class="empty-state__title">Services ready to seed</h3>
						<p class="empty-state__text">
							Complete initial EmDash setup to populate sample services.
						</p>
					</div>
				)
			}
		</div>
	</section>

	<!-- 4. Filterable Featured Projects Showcase -->
	<section class="st-projects-band section st-defer-section" aria-labelledby="home-projects-heading" data-project-filter-root>
		<div class="frame">
			<div class="st-section-header">
				<div>
					<p class="st-kicker st-kicker--on-dark">Recent Landmarks</p>
					<h2 id="home-projects-heading" class="st-heading st-heading--on-dark">
						Featured Works
					</h2>
				</div>

				<div class="st-filter-tabs" role="toolbar" aria-label="Filter projects by category">
					<button
						type="button"
						class="st-filter-btn is-active"
						data-filter="all"
						aria-pressed="true"
					>
						All Works
					</button>
					{
						projectCategories.map((cat) => (
							<button
								type="button"
								class="st-filter-btn"
								data-filter={cat.slug}
								aria-pressed="false"
							>
								{cat.label}
							</button>
						))
					}
				</div>
			</div>

			{
				projectsWithCats.length > 0 ? (
					<>
						<div class="st-projects-grid" data-projects-grid>
							{projectsWithCats.map(({ project, categories }) => (
								<div class="st-projects-grid__item" data-project-item={categories.map((c) => c.slug).join(" ")}>
									<ProjectCard
										project={project}
										categories={categories}
										headingLevel={3}
									/>
								</div>
							))}
						</div>
						<div class="st-projects-band__more">
							<a href="/projects" class="st-btn">
								View Full Portfolio ({projectsWithCats.length} Projects)
							</a>
						</div>
					</>
				) : (
					<p class="st-projects-empty">No projects published yet.</p>
				)
			}
		</div>
	</section>

	<!-- 5. Why Choose Structure + Stats Counters -->
	<section class="band section st-why st-defer-section" aria-labelledby="why-choose-heading">
		<div class="frame st-why__grid">
			<div class="st-why__media">
				<img
					src="/images/structure/why-choose-us.webp"
					alt="Structure site engineers reviewing structural plans"
					width="600"
					height="460"
					loading="lazy"
					decoding="async"
					class="st-why__img"
				/>
				<div class="st-why__stamp">
					<strong>18+</strong>
					<span>Years of Zero-Default Turnkey Delivery</span>
				</div>
			</div>

			<div class="st-why__content">
				<p class="st-kicker">Why Choose Structure</p>
				<h2 id="why-choose-heading" class="st-heading">
					Leading in Building & Civil Construction
				</h2>
				<p class="st-why__lead">
					We combine big-contractor structural muscle with boutique engineering
					accountability—aligning architects, estimators, and field crews from
					feasibility through 10-year warranty support.
				</p>

				<div class="st-why__features">
					<div class="st-why__item">
						<span class="st-why__num" aria-hidden="true">01</span>
						<div>
							<h3>Guaranteed Maximum Price</h3>
							<p>
								Open-book cost modeling locks your capital cap at 60% design,
								preventing surprise mid-build change orders.
							</p>
						</div>
					</div>
					<div class="st-why__item">
						<span class="st-why__num" aria-hidden="true">02</span>
						<div>
							<h3>5D BIM Clash Detection</h3>
							<p>
								Mechanical, plumbing, and structural steel conflicts are solved
								in digital twin simulations before concrete is poured.
							</p>
						</div>
					</div>
					<div class="st-why__item">
						<span class="st-why__num" aria-hidden="true">03</span>
						<div>
							<h3>ISO 9001 & OSHA Gold Safety</h3>
							<p>
								Daily inspection test plans, cylinder strength sensors, and
								strict zero-harm site protocols on every shift.
							</p>
						</div>
					</div>
					<div class="st-why__item">
						<span class="st-why__num" aria-hidden="true">04</span>
						<div>
							<h3>Self-Performing Core Trades</h3>
							<p>
								In-house foundation, structural concrete, and architectural
								finish crews protect critical-path milestones.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="frame st-stats">
			{
				stats.map((stat) => (
					<div class="st-stat">
						<span class="st-stat__number">{stat.number}</span>
						<span class="st-stat__label">{stat.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<!-- 6. Interactive Construction Cost Calculator -->
	<section id="home-estimator" class="band section st-estimator-band st-defer-section" aria-labelledby="estimator-heading">
		<div class="frame">
			<div class="st-section-header">
				<div>
					<p class="st-kicker">Self-Service Budget Planner</p>
					<h2 id="estimator-heading" class="st-heading">
						Interactive Construction Cost Calculator
					</h2>
				</div>
				<a href="/cost-calculator" class="arrow-link">
					Open Full Estimator Page
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>

			<CostCalculator compact />
		</div>
	</section>

	<!-- 7. Client Testimonials & Partner Logos -->
	{
		testimonials.length > 0 && (
			<section class="band section st-testimonials st-defer-section" aria-labelledby="testimonials-heading">
				<div class="frame">
					<div class="st-section-header st-section-header--center">
						<p class="st-kicker">Verified Owner Feedback</p>
						<h2 id="testimonials-heading" class="st-heading">
							What Our Clients Say
						</h2>
					</div>

					<div class="st-testimonials__grid">
						{testimonials.map((item) => (
							<blockquote class="st-testi-card">
								<div class="st-testi-card__stars">
									<span aria-hidden="true">{"★★★★★"}</span>
									<span class="sr-only">{`${item.data.rating ?? 5} out of 5 stars`}</span>
								</div>
								<p class="st-testi-card__quote" {...item.edit.quote}>
									“{item.data.quote}”
								</p>
								<footer class="st-testi-card__author">
									{item.data.avatar && (
										<div class="st-testi-card__avatar" {...item.edit.avatar}>
											<Image
												image={item.data.avatar}
												width={56}
												height={56}
												formats={["webp"]}
												placeholder={false}
												sizes="56px"
											/>
										</div>
									)}
									<div>
										<cite class="st-testi-card__name" {...item.edit.title}>
											{item.data.title}
										</cite>
										{item.data.role_company && (
											<span class="st-testi-card__role">
												{item.data.role_company}
											</span>
										)}
										{item.data.project_name && (
											<span class="st-testi-card__project">
												Project: {item.data.project_name}
											</span>
										)}
									</div>
								</footer>
							</blockquote>
						))}
					</div>

					<div class="st-partners">
						{partnerLogos.map((logo) => (
							<div class="st-partners__item">
								<img
									src={logo.src}
									alt={logo.alt}
									width="170"
									height="90"
									loading="lazy"
									decoding="async"
								/>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- 8. Latest Construction News & Insights -->
	{
		postsWithTags.length > 0 && (
			<section class="band section st-defer-section" aria-labelledby="latest-news-heading">
				<div class="frame">
					<div class="st-section-header">
						<div>
							<p class="st-kicker">Field Notes & Insights</p>
							<h2 id="latest-news-heading" class="st-heading">Latest News</h2>
						</div>
						<a href="/posts" class="arrow-link">
							View All Articles
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m12 5 7 7-7 7"></path>
							</svg>
						</a>
					</div>

					<div class="post-grid">
						{postsWithTags.map(({ post, tags }) => (
							<PostCard
								post={post}
								tags={tags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<script>
	// Hero Carousel Logic
	const hero = document.querySelector<HTMLElement>("[data-hero-carousel]");
	if (hero) {
		const slides = [
			...hero.querySelectorAll<HTMLElement>("[data-hero-slide]"),
		];
		const dots = [
			...hero.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"),
		];
		const prevBtn = hero.querySelector<HTMLButtonElement>("[data-hero-prev]");
		const nextBtn = hero.querySelector<HTMLButtonElement>("[data-hero-next]");
		let active = 0;
		let timer: number | undefined;

		const hydrateSlideMedia = (slide: HTMLElement | undefined) => {
			if (!slide) return;
			const img = slide.querySelector<HTMLImageElement>("img[data-src]");
			if (!img) return;
			if (img.dataset.srcset) {
				img.srcset = img.dataset.srcset;
				delete img.dataset.srcset;
			}
			if (img.dataset.src) {
				img.src = img.dataset.src;
				delete img.dataset.src;
			}
		};

		const goTo = (index: number) => {
			active = (index + slides.length) % slides.length;
			hydrateSlideMedia(slides[active]);
			slides.forEach((slide, i) => {
				const isCurrent = i === active;
				slide.classList.toggle("is-active", isCurrent);
				slide.setAttribute("aria-hidden", String(!isCurrent));
			});
			dots.forEach((dot, i) => {
				const isCurrent = i === active;
				dot.classList.toggle("is-active", isCurrent);
				if (isCurrent) {
					dot.setAttribute("aria-current", "true");
				} else {
					dot.removeAttribute("aria-current");
				}
			});
		};

		const startAuto = () => {
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			stopAuto();
			timer = window.setInterval(() => goTo(active + 1), 12000);
		};

		const stopAuto = () => {
			if (timer) window.clearInterval(timer);
		};

		prevBtn?.addEventListener("click", () => {
			goTo(active - 1);
			startAuto();
		});
		nextBtn?.addEventListener("click", () => {
			goTo(active + 1);
			startAuto();
		});
		dots.forEach((dot, idx) => {
			dot.addEventListener("click", () => {
				goTo(idx);
				startAuto();
			});
		});

		hero.addEventListener("mouseenter", stopAuto);
		hero.addEventListener("mouseleave", startAuto);
		hero.addEventListener("focusin", stopAuto);
		hero.addEventListener("focusout", startAuto);
		startAuto();
	}

	// Project Category Filter Tabs
	const filterRoot = document.querySelector<HTMLElement>(
		"[data-project-filter-root]",
	);
	if (filterRoot) {
		const buttons = [
			...filterRoot.querySelectorAll<HTMLButtonElement>("[data-filter]"),
		];
		const items = [
			...filterRoot.querySelectorAll<HTMLElement>("[data-project-item]"),
		];

		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const slug = btn.dataset.filter || "all";
				buttons.forEach((b) => {
					const isSelected = b === btn;
					b.classList.toggle("is-active", isSelected);
					b.setAttribute("aria-pressed", String(isSelected));
				});
				items.forEach((item) => {
					const cats = (item.dataset.projectItem || "").split(/\s+/);
					const show = slug === "all" || cats.includes(slug);
					item.hidden = !show;
				});
			});
