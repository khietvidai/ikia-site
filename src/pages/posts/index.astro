---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PageBanner from "../../components/PageBanner.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry =
	posts.length > 0
		? await getTermsForEntries(
				"posts",
				posts.map((p) => p.data.id),
				"tag",
			)
		: new Map();

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base
	title="Construction News & Field Insights"
	description="Articles on structural engineering, architectural renovation, project management, and sustainable building."
>
	<PageBanner
		highlight="Latest"
		title="News"
		subtitle="Field insights, adaptive-reuse case studies, and engineering perspectives from the Structure team."
		backgroundImage="/images/structure/banner-blog.jpg"
		breadcrumbs={[{ label: "News" }]}
	/>

	<section class="band section">
		<div class="frame">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "No more articles" : "No articles published yet"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "You have reached the end of the news archive."
								: "Published articles will appear here."}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/posts" class="st-btn st-btn--ghost">
									First page
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<div class="post-grid">
							{postsWithTags.map(({ post, tags }) => (
								<PostCard post={post} tags={tags} variant="card" headingLevel={2} />
							))}
						</div>
						<Pagination
							basePath="/posts"
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				)
			}
		</div>
	</section>
</Base>
