---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import {
	resolveBlogSiteIdentity,
	STRUCTURE_CONTACT,
} from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const [settingsResult, primaryMenuResult, servicesMenuResult, companyMenuResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_services"),
		getMenuWithCacheHint("company"),
	]);

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(primaryMenuResult.cacheHint);
	Astro.cache.set(servicesMenuResult.cacheHint);
	Astro.cache.set(companyMenuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const defaultNavItems = [
	{ label: "Home", url: "/", target: undefined },
	{ label: "Projects", url: "/projects", target: undefined },
	{ label: "Our Services", url: "/services", target: undefined },
	{ label: "About Us", url: "/pages/about", target: undefined },
	{ label: "Cost Calculator", url: "/cost-calculator", target: undefined },
	{ label: "News", url: "/posts", target: undefined },
	{ label: "Contact", url: "/contact", target: undefined },
];

const menuItems =
	primaryMenuResult.data?.items && primaryMenuResult.data.items.length > 0
		? primaryMenuResult.data.items
		: defaultNavItems;

const footerServices =
	servicesMenuResult.data?.items && servicesMenuResult.data.items.length > 0
		? servicesMenuResult.data.items
		: [
				{ label: "Design & Build Package", url: "/services/design-build-package" },
				{ label: "Building Renovation", url: "/services/building-renovation" },
				{ label: "Project Management", url: "/services/project-management" },
				{ label: "Construction Consulting", url: "/services/consulting" },
				{ label: "Architecture & BIM", url: "/services/architecture" },
				{ label: "Concrete & Structural", url: "/services/concrete-transport" },
			];

const footerCompany =
	companyMenuResult.data?.items && companyMenuResult.data.items.length > 0
		? companyMenuResult.data.items
		: [
				{ label: "About Structure", url: "/pages/about" },
				{ label: "Company History", url: "/pages/company-history" },
				{ label: "Core Values & Safety", url: "/pages/core-values" },
				{ label: "Leadership Team", url: "/pages/our-team" },
				{ label: "Service Pricing", url: "/pages/pricing" },
				{ label: "F.A.Q", url: "/pages/faq" },
			];

const defaultCanonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: description ?? siteTagline,
	canonical: canonical ?? defaultCanonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

function navCurrent(url: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(url, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	if (target.search && target.search !== Astro.url.search) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== "/" && currentPath.startsWith(`${path}/`)) return "true";
	if (
		path === "/projects" &&
		currentPath.startsWith("/project-category/")
	) {
		return "true";
	}
	if (
		path === "/posts" &&
		(currentPath.startsWith("/category/") || currentPath.startsWith("/tag/"))
	) {
		return "true";
	}
	if (path === "/pages/about" && currentPath.startsWith("/pages/")) {
		return "true";
	}
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<Font cssVariable="--font-heading" />
		<Font cssVariable="--font-body" />
		<slot name="head" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark") {
					document.documentElement.classList.replace("light", "dark");
				} else if (theme === "system") {
					document.documentElement.classList.remove("light", "dark");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>

		<!-- Structure Top Utility Bar -->
		<div class="st-topbar">
			<div class="frame st-topbar__inner">
				<ul class="st-topbar__contacts">
					<li>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
						</svg>
						<a href={STRUCTURE_CONTACT.phoneHref}>{STRUCTURE_CONTACT.phone}</a>
					</li>
					<li>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
						<span>{STRUCTURE_CONTACT.hours}</span>
					</li>
					<li class="st-topbar__hide-sm">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<rect width="20" height="16" x="2" y="4" rx="2"></rect>
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
						</svg>
						<a href={STRUCTURE_CONTACT.emailHref}>{STRUCTURE_CONTACT.email}</a>
					</li>
				</ul>

				<div class="st-topbar__right">
					<span class="st-topbar__license st-topbar__hide-md">
						{STRUCTURE_CONTACT.license}
					</span>
					<div class="st-topbar__links">
						<a href="/pages/certifications">ISO Certified</a>
						<a href="/pages/faq">F.A.Q</a>
						<a href="/_emdash/admin" class="st-topbar__admin">
							{isLoggedIn ? "CMS Admin" : "Admin Login"}
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Structure Sticky Main Navbar -->
		<header class="site-header" id="site-header">
			<div class="frame header-inner">
				<a href="/" class="brand" aria-label={`${siteTitle} — Home`}>
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="brand__logo"
								width="153"
								height="23"
							/>
						) : (
							<>
								<img
									src="/images/structure/logo-dark.png"
									alt=""
									aria-hidden="true"
									class="brand__logo brand__logo--light"
									width="153"
									height="23"
								/>
								<img
									src="/images/structure/logo-light.png"
									alt=""
									aria-hidden="true"
									class="brand__logo brand__logo--dark"
									width="195"
									height="35"
									loading="lazy"
									decoding="async"
								/>
								<span class="sr-only">{siteTitle}</span>
							</>
						)
					}
				</a>

				<nav class="site-nav" aria-label="Primary">
					<button
						class="menu-button"
						type="button"
						popovertarget="site-menu"
						popovertargetaction="toggle"
						aria-controls="site-menu"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<path d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
						<span>Menu</span>
					</button>

					<ul id="site-menu" class="site-menu" popover="auto">
						{
							menuItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target}
										rel={
											item.target === "_blank"
												? "noopener noreferrer"
												: undefined
										}
										aria-current={navCurrent(item.url)}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="site-header__actions">
					<div class="site-search" role="search" aria-label="Site">
						<svg
							class="site-search__icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.5-3.5"></path>
						</svg>
						<LiveSearch
							placeholder="Search..."
							class="site-search__field"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["projects", "services", "posts", "pages"]}
						/>
						<kbd class="site-search__kbd" aria-hidden="true">
							<span dir="ltr">⌘K</span>
						</kbd>
					</div>

					<a
						href="/search"
						class="icon-btn site-search-link"
						aria-label="Search site"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-3.5-3.5"></path>
						</svg>
					</a>

					<a href="/contact#quote-form" class="st-btn st-btn--sm header-cta">
						Get a Quote
					</a>
				</div>
			</div>
		</header>

		<script is:inline>
			(function () {
				var header = document.getElementById("site-header");
				if (header && window.matchMedia("(min-width: 1040px)").matches) {
					header.classList.add("is-wide");
				}
			})();
		</script>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<!-- Structure 4-Column Industrial Navy Footer -->
		<footer class="st-footer">
			<div class="frame st-footer__grid">
				<div class="st-footer__col st-footer__about">
					<a href="/" class="st-footer__logo-link" aria-label={siteTitle}>
						<img
							src="/images/structure/logo-light.png"
							alt={siteTitle}
							width="195"
							height="35"
							loading="lazy"
						/>
					</a>
					<p class="st-footer__desc">
						{siteTagline}. Integrity in engineering, transparent GMP budgeting,
						and ISO-certified construction excellence across commercial, civil,
						and residential landmarks.
					</p>
					<div class="st-footer__widgets">
						<WidgetArea name="footer" />
					</div>
				</div>

				<nav class="st-footer__col" aria-labelledby="footer-services-heading">
					<h2 id="footer-services-heading" class="st-footer__heading">
						Our Services
					</h2>
					<ul class="st-footer__links">
						{
							footerServices.map((item) => (
								<li>
									<a href={item.url}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="st-footer__col" aria-labelledby="footer-company-heading">
					<h2 id="footer-company-heading" class="st-footer__heading">
						Information
					</h2>
					<ul class="st-footer__links">
						{
							footerCompany.map((item) => (
								<li>
									<a href={item.url}>{item.label}</a>
								</li>
							))
						}
						<li>
							<a href="/cost-calculator">Construction Cost Calculator</a>
						</li>
						<li>
							<a href="/rss.xml">News RSS Feed</a>
						</li>
					</ul>
				</nav>

				<div class="st-footer__col">
					<h2 class="st-footer__heading">Structure Office</h2>
					<ul class="st-footer__office">
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
							<span>{STRUCTURE_CONTACT.address}</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<a href={STRUCTURE_CONTACT.phoneHref}>
								{STRUCTURE_CONTACT.phone} · {STRUCTURE_CONTACT.secondaryPhone}
							</a>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<rect width="20" height="16" x="2" y="4" rx="2"></rect>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
							</svg>
							<a href={STRUCTURE_CONTACT.emailHref}>{STRUCTURE_CONTACT.email}</a>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
							<span>{STRUCTURE_CONTACT.hours}</span>
						</li>
					</ul>
					<div class="st-footer__cta">
						<a href="/contact#quote-form" class="st-btn st-btn--sm">
							Request Free Estimate
						</a>
					</div>
				</div>
			</div>

			<div class="st-footer__bottom">
				<div class="frame st-footer__bottom-inner">
					<p class="st-footer__copyright">
						© {year} <strong>{siteTitle}</strong>. Powered by{" "}
						<a href="https://emdashcms.com">EmDash CMS</a> ·{" "}
						<a href="/_emdash/admin">Manage Content</a>
					</p>

					<div class="st-footer__bottom-tools">
						<div class="theme-switcher" role="group" aria-label="Color theme">
							<button
								type="button"
								class="theme-btn active"
								data-theme="light"
								aria-label="Light mode"
								aria-pressed="true"
							>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<circle cx="12" cy="12" r="4"></circle>
									<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
								</svg>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="dark"
								aria-label="Dark mode"
								aria-pressed="false"
							>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
								</svg>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="system"
								aria-label="System theme"
								aria-pressed="false"
							>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<rect x="2" y="3" width="20" height="14" rx="2"></rect>
									<path d="M8 21h8M12 17v4"></path>
								</svg>
							</button>
						</div>

						<a href="#top" class="st-scroll-top" aria-label="Scroll to top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
								<path d="m18 15-6-6-6 6"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Feature-detected Popover polyfill for older browsers
			if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
				// @ts-expect-error CDN fallback module
				import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
			}

			// Responsive navbar measurement (modern-web-guidance `navbar`)
			const header = document.getElementById("site-header");
			const inner = header?.querySelector<HTMLElement>(".header-inner");
			const menu = document.getElementById("site-menu");

			if (header && inner && menu) {
				let lastHeaderWidth = 0;

				const syncNavLayout = (measuredWidth?: number) => {
					const isNarrowViewport =
						measuredWidth !== undefined
							? measuredWidth < 880
							: window.matchMedia("(max-width: 879px)").matches;
					if (isNarrowViewport) {
						header.classList.remove("is-wide", "is-measuring");
						if (!menu.hasAttribute("popover")) {
							menu.setAttribute("popover", "auto");
						}
						return;
					}

					const wasOpen =
						menu.matches(":popover-open") ||
						menu.classList.contains(":popover-open");
					header.classList.add("is-measuring", "is-wide");
					menu.removeAttribute("popover");

					const fits = inner.scrollWidth <= inner.clientWidth;

					if (fits) {
						header.classList.add("is-wide");
						menu.removeAttribute("popover");
					} else {
						header.classList.remove("is-wide");
						menu.setAttribute("popover", "auto");
						if (wasOpen && typeof menu.showPopover === "function") {
							try {
								menu.showPopover();
							} catch {}
						}
					}

					requestAnimationFrame(() => {
						header.classList.remove("is-measuring");
					});
				};

				const ro = new ResizeObserver((entries) => {
					const entry = entries[0];
					const width =
						entry && entry.contentBoxSize && entry.contentBoxSize[0]
							? entry.contentBoxSize[0].inlineSize
							: 0;
					const isWide = header.classList.contains("is-wide");
					if (lastHeaderWidth === 0 || isWide || width > lastHeaderWidth) {
						lastHeaderWidth = width;
						syncNavLayout(width);
					} else {
						lastHeaderWidth = width;
					}
				});

				ro.observe(header);
			}

			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function syncThemeButtons(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function setTheme(theme: string) {
				setCookie("theme", theme);
				if (theme === "system") {
					root.classList.remove("light", "dark");
				} else if (theme === "dark") {
					root.classList.remove("light");
					root.classList.add("dark");
				} else {
					root.classList.remove("dark");
					root.classList.add("light");
				}
				syncThemeButtons(theme);
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "light";
			}

			const initialTheme = getStoredTheme();
			if (initialTheme !== "light") {
				syncThemeButtons(initialTheme);
