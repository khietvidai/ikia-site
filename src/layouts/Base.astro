			.st-footer__bottom-tools {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.theme-switcher {
				display: inline-flex;
				gap: 3px;
				padding: 3px;
				border-radius: var(--radius-sm);
				background: rgb(255 255 255 / 0.07);
				border: 1px solid rgb(255 255 255 / 0.12);
			}

			.theme-btn {
				display: grid;
				place-items: center;
				inline-size: 2rem;
				block-size: 2rem;
				padding: 0;
				border: 0;
				border-radius: 2px;
				background: transparent;
				color: var(--st-navy-muted);
				cursor: pointer;
			}

			.theme-btn:hover {
				color: #ffffff;
			}

			.theme-btn.active {
				background: var(--st-yellow);
				color: #111111;
			}

			.theme-btn svg {
				inline-size: 14px;
				block-size: 14px;
			}

			.st-scroll-top {
				display: grid;
				place-items: center;
				inline-size: 2.15rem;
				block-size: 2.15rem;
				border-radius: var(--radius-sm);
				background: var(--st-yellow);
				color: #111111;
				text-decoration: none;
			}

			.st-scroll-top svg {
				inline-size: 16px;
				block-size: 16px;
			}

			@media (forced-colors: active) {
				.site-menu a[aria-current="page"],
				.site-menu a[aria-current="true"],
				.theme-btn.active {
					border: 2px solid Highlight;
				}
