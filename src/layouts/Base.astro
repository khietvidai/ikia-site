			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "light");
				});
			});

			// ⌘K / Ctrl+K focuses header search
			const searchInput =
				document.querySelector<HTMLInputElement>(".site-search-input");
			const kbd = document.querySelector(".site-search__kbd span");
