---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
const uid = compact ? "home-calc" : "page-calc";
---

<div class:list={["st-calc", { "st-calc--compact": compact }]} data-cost-calculator>
	<div class="st-calc__controls">
		<div class="st-calc__field">
			<label for={`${uid}-type`} class="st-calc__label">
				1. Construction Project Type
			</label>
			<select id={`${uid}-type`} class="st-calc__select" data-calc-type>
				<option value="1450" data-label="Commercial / Office Building">
					Commercial / Office Building ($1,450 / m² base)
				</option>
				<option value="1680" selected data-label="Design & Build Custom Villa">
					Design & Build Custom Villa ($1,680 / m² base)
				</option>
				<option value="890" data-label="Building Renovation & Retrofit">
					Building Renovation & Retrofit ($890 / m² base)
				</option>
				<option value="1120" data-label="Industrial / Civil Facility">
					Industrial / Civil Facility ($1,120 / m² base)
				</option>
			</select>
		</div>

		<div class="st-calc__field">
			<div class="st-calc__label-row">
				<label for={`${uid}-area`} class="st-calc__label">
					2. Total Floor Area (m²)
				</label>
				<output for={`${uid}-area`} class="st-calc__badge" data-calc-area-out>
					450 m²
				</output>
			</div>
			<input
				type="range"
				id={`${uid}-area`}
				min="80"
				max="5000"
				step="10"
				value="450"
				class="st-calc__range"
				data-calc-area
			/>
			<div class="st-calc__scale" aria-hidden="true">
				<span>80 m²</span>
				<span>1,500 m²</span>
				<span>3,000 m²</span>
				<span>5,000 m²</span>
			</div>
		</div>

		<div class="st-calc__field">
			<span class="st-calc__label" id={`${uid}-tier-label`}>
				3. Architectural Finish & Specification Tier
			</span>
			<div class="st-calc__tiers" role="radiogroup" aria-labelledby={`${uid}-tier-label`}>
				<label class="st-calc__tier">
					<input type="radio" name={`${uid}-tier`} value="1.0" data-calc-tier data-tier-name="Standard Commercial" />
					<span>
						<strong>Standard</strong>
						<small>1.0× Core Spec</small>
					</span>
				</label>
				<label class="st-calc__tier">
					<input type="radio" name={`${uid}-tier`} value="1.22" checked data-calc-tier data-tier-name="Executive Architectural" />
					<span>
						<strong>Architectural</strong>
						<small>1.22× Premium</small>
					</span>
				</label>
				<label class="st-calc__tier">
					<input type="radio" name={`${uid}-tier`} value="1.42" data-calc-tier data-tier-name="LEED Platinum / Net-Zero" />
					<span>
						<strong>Net-Zero LEED</strong>
						<small>1.42× Turnkey</small>
					</span>
				</label>
			</div>
		</div>

		<fieldset class="st-calc__field st-calc__fieldset">
			<legend class="st-calc__label">4. Engineering & Site Packages</legend>
			<div class="st-calc__addons">
				<label class="st-calc__check">
					<input type="checkbox" value="18000" checked data-calc-addon data-addon-name="5D BIM & Structural Blueprints" />
					<span>5D BIM & Blueprints (+$18k)</span>
				</label>
				<label class="st-calc__check">
					<input type="checkbox" value="32000" data-calc-addon data-addon-name="Deep Foundation / Piling" />
					<span>Deep Foundation (+$32k)</span>
				</label>
				<label class="st-calc__check">
					<input type="checkbox" value="26000" checked data-calc-addon data-addon-name="Solar + Thermal Isolation" />
					<span>Solar & Isolation (+$26k)</span>
				</label>
				<label class="st-calc__check">
					<input type="checkbox" value="14500" data-calc-addon data-addon-name="Municipal Permits & QA" />
					<span>Permits & QA (+$14.5k)</span>
				</label>
			</div>
		</fieldset>
	</div>

	<div class="st-calc__summary" aria-live="polite">
		<p class="st-kicker st-kicker--on-dark">Instant GMP Ballpark</p>
		<h3 class="st-calc__summary-title">Estimated Turnkey Budget</h3>

		<div class="st-calc__price" data-calc-total>$966,320</div>
		<p class="st-calc__range-note" data-calc-band>
			Indicative GMP Range: $918,004 – $1,014,636
		</p>

		<dl class="st-calc__breakdown">
			<div>
				<dt>Structural & Core Build</dt>
				<dd data-calc-base>$922,320</dd>
			</div>
			<div>
				<dt>Selected Engineering Packages</dt>
				<dd data-calc-extras>$44,000</dd>
			</div>
			<div>
				<dt>Estimated Delivery Schedule</dt>
				<dd data-calc-months>7 – 9 Months</dd>
			</div>
		</dl>

		<a
			href="/contact?estimate=Design%20%26%20Build%20Custom%20Villa%20%C2%B7%20450%20m%C2%B2%20(Executive%20Architectural)%20%C2%B7%20Est.%20%24966%2C320#quote-form"
			class="st-btn st-calc__cta"
			data-calc-cta
		>
			Lock In Official Quote
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
				<path d="M5 12h14"></path>
				<path d="m12 5 7 7-7 7"></path>
			</svg>
		</a>
		<p class="st-calc__disclaimer">
			*Unit rates reflect 2026 CSI MasterFormat benchmarks. Includes 10-year
			structural frame warranty.
		</p>
	</div>
</div>

<script>
	let fmt: Intl.NumberFormat | undefined;

	document
		.querySelectorAll<HTMLElement>("[data-cost-calculator]")
		.forEach((root) => {
			const typeEl = root.querySelector("[data-calc-type]") as HTMLSelectElement | null;
			const areaEl = root.querySelector("[data-calc-area]") as HTMLInputElement | null;
			const areaOut = root.querySelector("[data-calc-area-out]") as HTMLElement | null;
			const totalOut = root.querySelector("[data-calc-total]") as HTMLElement | null;
			const bandOut = root.querySelector("[data-calc-band]") as HTMLElement | null;
			const baseOut = root.querySelector("[data-calc-base]") as HTMLElement | null;
			const extrasOut = root.querySelector("[data-calc-extras]") as HTMLElement | null;
			const monthsOut = root.querySelector("[data-calc-months]") as HTMLElement | null;
			const ctaEl = root.querySelector("[data-calc-cta]") as HTMLAnchorElement | null;

			const recalculate = () => {
				if (!typeEl || !areaEl) return;
				fmt ??= new Intl.NumberFormat("en-US", {
					style: "currency",
					currency: "USD",
					maximumFractionDigits: 0,
				});
				const unitRate = Number(typeEl.value) || 1500;
				const typeLabel =
					typeEl.selectedOptions[0]?.dataset.label || "Construction Project";
				const area = Number(areaEl.value) || 450;

				const checkedTier =
					root.querySelector<HTMLInputElement>("[data-calc-tier]:checked");
				const tierMultiplier = Number(checkedTier?.value || 1);
				const tierName = checkedTier?.dataset.tierName || "Standard";

				let extras = 0;
				root
					.querySelectorAll<HTMLInputElement>("[data-calc-addon]:checked")
					.forEach((cb) => {
						extras += Number(cb.value) || 0;
					});

				const baseCost = Math.round(area * unitRate * tierMultiplier);
				const total = baseCost + extras;
				const low = Math.round(total * 0.95);
				const high = Math.round(total * 1.05);

				const minMonths = Math.max(3, Math.round(3 + area / 240));
				const maxMonths = minMonths + 3;

				if (areaOut) areaOut.textContent = `${area.toLocaleString("en-US")} m²`;
				if (totalOut) totalOut.textContent = fmt.format(total);
				if (bandOut) {
					bandOut.textContent = `Indicative GMP Range: ${fmt.format(low)} – ${fmt.format(high)}`;
				}
				if (baseOut) baseOut.textContent = fmt.format(baseCost);
				if (extrasOut) extrasOut.textContent = fmt.format(extras);
				if (monthsOut) monthsOut.textContent = `${minMonths} – ${maxMonths} Months`;

				if (ctaEl) {
					const summary = `${typeLabel} · ${area} m² (${tierName}) · Est. ${fmt.format(total)}`;
					ctaEl.href = `/contact?estimate=${encodeURIComponent(summary)}#quote-form`;
				}
			};

			root.addEventListener("input", recalculate);
			root.addEventListener("change", recalculate);
		});
</script>

<style>
	.st-calc {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		background: var(--color-surface);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-card);
	}

	.st-calc__controls {
		display: grid;
		gap: 1.5rem;
		padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
	}

	.st-calc__fieldset {
		border: 0;
		margin: 0;
		padding: 0;
		min-inline-size: 0;
	}

	.st-calc__label-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.st-calc__label {
		display: block;
		margin-block-end: 0.55rem;
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.st-calc__badge {
		padding: 3px 10px;
		border-radius: 2px;
		background: var(--st-yellow);
		color: #111111;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.st-calc__select {
		inline-size: 100%;
		block-size: 46px;
		padding-inline: 0.9rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.st-calc__range {
		inline-size: 100%;
		accent-color: var(--st-yellow);
		cursor: pointer;
	}

	.st-calc__scale {
		display: flex;
		justify-content: space-between;
		margin-block-start: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-muted);
	}

	.st-calc__tiers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.st-calc__tier {
		position: relative;
		cursor: pointer;
	}

	.st-calc__tier input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.st-calc__tier span {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.75rem 0.8rem;
		border: 2px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		transition:
			border-color var(--transition-fast),
			background-color var(--transition-fast);
	}

	.st-calc__tier strong {
		font-family: var(--font-heading);
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.st-calc__tier small {
		font-size: 0.74rem;
		color: var(--color-muted);
	}

	.st-calc__tier input:checked + span {
		border-color: var(--st-yellow);
		background: var(--st-yellow-soft);
	}

	.st-calc__tier input:focus-visible + span {
		outline: 2px solid var(--st-yellow);
		outline-offset: 2px;
	}

	.st-calc__addons {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}

	.st-calc__check {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
	}

	.st-calc__check input {
		inline-size: 16px;
		block-size: 16px;
		accent-color: var(--st-yellow);
		flex-shrink: 0;
	}

	/* Dark Summary Panel */
	.st-calc__summary {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
		background: var(--st-navy);
		color: #ffffff;
		border-inline-start: 4px solid var(--st-yellow);
	}

	.st-calc__summary-title {
		margin-block-start: 0.4rem;
		font-size: 1.25rem;
		text-transform: uppercase;
		color: #ffffff;
	}

	.st-calc__price {
		margin-block-start: 1rem;
		font-family: var(--font-heading);
		font-size: clamp(2.1rem, 1.7rem + 1.8vw, 3rem);
		font-weight: 800;
		line-height: 1;
		color: var(--st-yellow);
		font-variant-numeric: tabular-nums;
	}

	.st-calc__range-note {
		margin-block-start: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--st-navy-muted);
	}

	.st-calc__breakdown {
		display: grid;
		gap: 0.75rem;
		margin-block: 1.5rem;
		padding-block: 1.25rem;
		border-block: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.875rem;
	}

	.st-calc__breakdown > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.st-calc__breakdown dt {
		color: var(--st-navy-muted);
	}

	.st-calc__breakdown dd {
		font-family: var(--font-mono);
		font-weight: 600;
		color: #ffffff;
	}

	.st-calc__cta {
		inline-size: 100%;
	}

	.st-calc__cta svg {
		inline-size: 16px;
		block-size: 16px;
	}

	.st-calc__disclaimer {
		margin-block-start: 0.9rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--st-navy-muted);
	}

	@media (max-width: 920px) {
		.st-calc {
			grid-template-columns: minmax(0, 1fr);
		}

		.st-calc__summary {
			border-inline-start: 0;
			border-block-start: 4px solid var(--st-yellow);
		}
	}

	@media (max-width: 600px) {
		.st-calc__tiers,
		.st-calc__addons {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
